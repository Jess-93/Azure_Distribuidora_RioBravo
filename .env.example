FOUNDRY_PROJECT_ENDPOINT=TUURLAQUÍ
FOUNDRY_AGENT_NAME=ELNOMBREDELAGENTE
# Optional full OpenAI-protocol endpoint for the separate inventory agent.
# Keep blank until the agent is ready; paste its Foundry endpoint here.
FOUNDRY_INVENTORY_AGENT_ENDPOINT=
CHAT_SESSION_DB_PATH=.data/chat_sessions.sqlite3
CHAT_REQUESTS_PER_MINUTE=60

# Backend-only. Never prefix these settings with VITE_.
AZURE_SPEECH_KEY=replace-with-a-Speech-resource-key
AZURE_SPEECH_REGION=eastus
SPEECH_REQUESTS_PER_MINUTE=30
SPEECH_GLOBAL_REQUESTS_PER_MINUTE=300
# Optional comma-separated proxy peer CIDRs. Leave blank unless the immediate
# proxy CIDRs are verified for this deployment; X-Forwarded-For is ignored otherwise.
SPEECH_TRUSTED_PROXY_CIDRS=

# Backend-only shared demonstration credentials. Configure independently in each environment.
ALMACEN_USERNAME=replace-with-inventory-username
ALMACEN_PASSWORD=replace-with-a-strong-inventory-password
INVENTORY_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
